# Sentinel — server environment. Copy to `server/.env` and fill in your own keys.
# Everything runs in TEST MODE. Never commit real keys.

PORT=4100

# AI engine (preference: Anthropic → Gemini → built-in rules). Add either or none.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cost gate: LLM_GATE=exact → unambiguous (known Razorpay reason) failures are
# diagnosed by the zero-cost rules engine and skip the LLM; only the ambiguous
# long tail spends an LLM call. Unset (default) = LLM diagnoses every case.
LLM_GATE=

# Voice (optional) — natural Hindi TTS
ELEVENLABS_API_KEY=

# Razorpay (TEST mode only — never live keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=   # set to verify inbound webhook signatures

# Execution: false = create real test-mode links / calls; true = fully simulated
DRY_RUN=false

# Twilio (optional) — WhatsApp + voice calls in test mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEST_TO=
TWILIO_CALLER_ID=
TWILIO_TWIML_URL=

# Demo auto-call target (the number the demo call rings, and the name it greets)
DEMO_CALL_TO=
DEMO_CALL_NAME=
